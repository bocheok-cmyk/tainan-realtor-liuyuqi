# Supabase — 從 Supabase 專案的 Settings > API 頁面複製
# 這個網站要用「全新、獨立」的 Supabase 專案，不要跟中控情報台共用
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=

# Resend — 部落格文章下方留言表單，寄到你信箱用
RESEND_API_KEY=
CONTACT_EMAIL_TO=

# Facebook Pixel（後台設定頁也可以填，這裡是預設值）
NEXT_PUBLIC_FB_PIXEL_ID=

# Google Analytics 4 + Search Console（等網站正式有網域再申請）
NEXT_PUBLIC_GA4_MEASUREMENT_ID=

# 以下不要放在這裡長期保留，只在跑 scripts/create-admin-user.mjs 那一次用環境變數暫時設定：
# SUPABASE_SERVICE_ROLE_KEY、ADMIN_USERNAME、ADMIN_PASSWORD
